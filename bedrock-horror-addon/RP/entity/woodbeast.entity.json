{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "horror:woodbeast",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/woodbeast"
      },
      "geometry": {
        "default": "geometry.horror_woodbeast"
      },
      "animations": {
        "walk": "animation.horror.woodbeast.walk",
        "idle": "animation.horror.woodbeast.idle",
        "tail": "animation.horror.woodbeast.tail",
        "hunt": "animation.horror.woodbeast.hunt",
        "attack": "animation.horror.woodbeast.attack",
        "look_at": "animation.horror.woodbeast.look_at"
      },
      "scripts": {
        "pre_animation": [
          "variable.dt = math.min(query.delta_time, 0.1);",
          "variable.speed = math.lerp(variable.speed ?? 0, math.min(query.modified_move_speed * 1.4, 1), math.min(variable.dt * 8, 1));",
          "variable.hunt = math.lerp(variable.hunt ?? 0, query.has_target, math.min(variable.dt * 2.5, 1));",
          "variable.atk = variable.attack_time ?? 0;",
          "variable.still = 0;"
        ],
        "animate": [
          "look_at",
          {
            "walk": "variable.speed"
          },
          {
            "idle": "1 - variable.speed"
          },
          "tail",
          {
            "hunt": "variable.hunt"
          },
          "attack"
        ]
      },
      "render_controllers": [
        "controller.render.horror_default"
      ],
      "spawn_egg": {
        "base_color": "#2a1c12",
        "overlay_color": "#ffbe1e"
      }
    }
  }
}
