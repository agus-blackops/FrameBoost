{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.hl.default": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.hl.null": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": "math.random(0.0, 1.0) > 0.04"
        },
        {
          "halo": "math.mod(math.floor(query.life_time * 7.0), 3) != 0"
        },
        {
          "hitbox": "math.mod(math.floor(query.life_time * 2.0), 5) != 0"
        }
      ]
    },
    "controller.render.hl.fake_player": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.property('hl:eyes') ? Texture.eyes : Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "tool": "query.property('hl:state') == 'swing'"
        }
      ]
    },
    "controller.render.hl.false_tree": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": "query.property('hl:revealed')"
        },
        {
          "trunk": "!query.property('hl:revealed')"
        }
      ]
    },
    "controller.render.hl.jenny": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "girl": "!query.property('hl:revealed')"
        },
        {
          "gRightLeg": "!query.property('hl:revealed')"
        },
        {
          "gLeftLeg": "!query.property('hl:revealed')"
        },
        {
          "gBody": "!query.property('hl:revealed')"
        },
        {
          "gHead": "!query.property('hl:revealed')"
        },
        {
          "gPonytail": "!query.property('hl:revealed')"
        },
        {
          "gRightArm": "!query.property('hl:revealed')"
        },
        {
          "gLeftArm": "!query.property('hl:revealed')"
        },
        {
          "dweller": "query.property('hl:revealed')"
        },
        {
          "dRightLeg": "query.property('hl:revealed')"
        },
        {
          "dRightShin": "query.property('hl:revealed')"
        },
        {
          "dLeftLeg": "query.property('hl:revealed')"
        },
        {
          "dLeftShin": "query.property('hl:revealed')"
        },
        {
          "dHips": "query.property('hl:revealed')"
        },
        {
          "dChest": "query.property('hl:revealed')"
        },
        {
          "dNeck": "query.property('hl:revealed')"
        },
        {
          "dHead": "query.property('hl:revealed')"
        },
        {
          "dRightJaw": "query.property('hl:revealed')"
        },
        {
          "dLeftJaw": "query.property('hl:revealed')"
        },
        {
          "dPonytail": "query.property('hl:revealed')"
        },
        {
          "dRightArm": "query.property('hl:revealed')"
        },
        {
          "dRightForearm": "query.property('hl:revealed')"
        },
        {
          "dLeftArm": "query.property('hl:revealed')"
        },
        {
          "dLeftForearm": "query.property('hl:revealed')"
        }
      ]
    },
    "controller.render.hl.boss": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.property('hl:phase') == 2 ? Texture.phase2 : Texture.default"
      ]
    }
  }
}
