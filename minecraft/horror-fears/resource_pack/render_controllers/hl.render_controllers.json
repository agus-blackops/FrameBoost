{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.hl.default": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.hl.null": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": "math.random(0.0, 1.0) > 0.04"
        },
        {
          "halo": "math.mod(math.floor(query.life_time * 7.0), 3) != 0"
        },
        {
          "hitbox": "math.mod(math.floor(query.life_time * 2.0), 5) != 0"
        }
      ]
    },
    "controller.render.hl.fake_player": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.property('hl:eyes') ? Texture.eyes : Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "tool": "query.property('hl:state') == 'swing'"
        }
      ]
    },
    "controller.render.hl.false_tree": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": "query.property('hl:revealed')"
        },
        {
          "trunk": "!query.property('hl:revealed')"
        }
      ]
    },
    "controller.render.hl.jenny": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "humanHead": "!query.property('hl:revealed')"
        },
        {
          "ponytail": "!query.property('hl:revealed')"
        },
        {
          "rightArm": "!query.property('hl:revealed')"
        },
        {
          "leftArm": "!query.property('hl:revealed')"
        },
        {
          "monsterHead": "query.property('hl:revealed')"
        },
        {
          "monsterTail": "query.property('hl:revealed')"
        },
        {
          "rightJaw": "query.property('hl:revealed')"
        },
        {
          "leftJaw": "query.property('hl:revealed')"
        },
        {
          "rightClaw": "query.property('hl:revealed')"
        },
        {
          "leftClaw": "query.property('hl:revealed')"
        }
      ]
    },
    "controller.render.hl.boss": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.property('hl:phase') == 2 ? Texture.phase2 : Texture.default"
      ]
    }
  }
}
