{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "hl:rake",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/hl/rake"
      },
      "geometry": {
        "default": "geometry.hl.rake"
      },
      "animations": {
        "look": "animation.hl.rake.look",
        "idle": "animation.hl.rake.idle",
        "run": "animation.hl.rake.run",
        "attack": "animation.hl.rake.attack",
        "hurt": "animation.hl.rake.hurt"
      },
      "scripts": {
        "animate": [
          "look",
          {
            "idle": "!(query.modified_move_speed > 0.05)"
          },
          {
            "run": "query.modified_move_speed > 0.05"
          },
          {
            "attack": "variable.attack_time > 0.0"
          },
          {
            "hurt": "query.hurt_time > 0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.hl.default"
      ],
      "spawn_egg": {
        "base_color": "#d0cac0",
        "overlay_color": "#1a1410"
      }
    }
  }
}
