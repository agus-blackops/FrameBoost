{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "hl:fake_player",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/hl/fake_player",
        "eyes": "textures/entity/hl/fake_player_eyes"
      },
      "geometry": {
        "default": "geometry.hl.fake_player"
      },
      "animations": {
        "look": "animation.hl.player.look",
        "walk": "animation.hl.player.walk",
        "idle": "animation.hl.player.idle",
        "sneak": "animation.hl.player.sneak",
        "swing": "animation.hl.player.swing",
        "stare": "animation.hl.player.stare",
        "air": "animation.hl.player.air",
        "walk_extra": "animation.hl.player.walk_extra"
      },
      "scripts": {
        "animate": [
          {
            "look": "query.property('hl:state') != 'stare'"
          },
          "walk",
          "idle",
          {
            "sneak": "query.property('hl:state') == 'sneak'"
          },
          {
            "swing": "query.property('hl:state') == 'swing'"
          },
          {
            "stare": "query.property('hl:state') == 'stare'"
          },
          {
            "air": "!query.is_on_ground"
          },
          {
            "walk_extra": "query.modified_move_speed > 0.05"
          }
        ]
      },
      "render_controllers": [
        "controller.render.hl.fake_player"
      ],
      "spawn_egg": {
        "base_color": "#1ca2a6",
        "overlay_color": "#3e389c"
      }
    }
  }
}
