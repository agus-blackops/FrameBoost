{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "hl:goatman",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/hl/goatman"
      },
      "geometry": {
        "default": "geometry.hl.goatman"
      },
      "animations": {
        "look": "animation.hl.goatman.look",
        "idle": "animation.hl.goatman.idle",
        "walk": "animation.hl.goatman.walk",
        "run": "animation.hl.goatman.run",
        "scream": "animation.hl.goatman.scream",
        "attack": "animation.hl.goatman.attack",
        "walk_extra": "animation.hl.goatman.walk_extra",
        "hurt": "animation.hl.goatman.hurt"
      },
      "scripts": {
        "animate": [
          "look",
          "idle",
          {
            "walk": "query.modified_move_speed > 0.05"
          },
          {
            "run": "query.property('hl:mode') == 'charge'"
          },
          {
            "scream": "query.property('hl:scream')"
          },
          {
            "attack": "variable.attack_time > 0.0"
          },
          {
            "walk_extra": "query.modified_move_speed > 0.05"
          },
          {
            "hurt": "query.hurt_time > 0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.hl.default"
      ],
      "spawn_egg": {
        "base_color": "#1f1812",
        "overlay_color": "#e8c020"
      }
    }
  }
}
