{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "hl:mimic",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/hl/mimic"
      },
      "geometry": {
        "default": "geometry.hl.mimic"
      },
      "animations": {
        "awake": "animation.hl.mimic.awake",
        "walk": "animation.hl.mimic.walk",
        "attack": "animation.hl.mimic.attack",
        "asleep": "animation.hl.mimic.asleep",
        "hurt": "animation.hl.mimic.hurt"
      },
      "scripts": {
        "animate": [
          {
            "asleep": "!query.property('hl:awake')"
          },
          {
            "awake": "query.property('hl:awake')"
          },
          {
            "walk": "query.modified_move_speed > 0.05"
          },
          {
            "attack": "variable.attack_time > 0.0"
          },
          {
            "hurt": "query.hurt_time > 0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.hl.mimic"
      ],
      "spawn_egg": {
        "base_color": "#8a5e2c",
        "overlay_color": "#a83e34"
      }
    }
  }
}
