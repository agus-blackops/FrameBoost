{
  "format_version": "1.8.0",
  "animations": {
    "animation.bw.humanoid.walk": {
      "loop": true,
      "bones": {
        "rightLeg": { "rotation": ["math.cos(query.modified_distance_moved * 38.17) * 70.0 * query.modified_move_speed", 0, 0] },
        "leftLeg": { "rotation": ["-math.cos(query.modified_distance_moved * 38.17) * 70.0 * query.modified_move_speed", 0, 0] },
        "rightArm": { "rotation": ["-math.cos(query.modified_distance_moved * 38.17) * 50.0 * query.modified_move_speed", 0, 0] },
        "leftArm": { "rotation": ["math.cos(query.modified_distance_moved * 38.17) * 50.0 * query.modified_move_speed", 0, 0] }
      }
    },
    "animation.bw.humanoid.look_at_target": {
      "loop": true,
      "bones": {
        "head": { "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0] }
      }
    },
    "animation.bw.humanoid.attack": {
      "loop": true,
      "bones": {
        "rightArm": { "rotation": ["-math.sin(variable.attack_time * 180.0) * 110.0", 0, 0] },
        "leftArm": { "rotation": ["-math.sin(variable.attack_time * 180.0) * 110.0", 0, 0] }
      }
    },
    "animation.bw.witch.drift": {
      "loop": true,
      "bones": {
        "root": { "position": [0, "math.sin(query.life_time * 60.0) * 0.6", 0] },
        "head": { "rotation": [12.0, 0, "math.sin(query.life_time * 25.0) * 8.0"] },
        "rightArm": { "rotation": ["-6.0 + math.sin(query.life_time * 40.0) * 4.0", 0, 6.0] },
        "leftArm": { "rotation": ["-6.0 - math.sin(query.life_time * 40.0) * 4.0", 0, -6.0] }
      }
    },
    "animation.bw.corner_man.stand": {
      "loop": true,
      "bones": {
        "head": { "rotation": [22.0, 0, 0] },
        "body": { "rotation": [3.0, 0, 0] }
      }
    },
    "animation.bw.stick_figure.sway": {
      "loop": true,
      "bones": {
        "figure": {
          "rotation": [
            "math.sin(query.life_time * 50.0) * 3.0",
            "math.sin(query.life_time * 18.0) * 35.0",
            "math.cos(query.life_time * 45.0) * 3.0"
          ]
        }
      }
    }
  }
}
