{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.hb.green_steve.flow": {
      "initial_state": "still",
      "states": {
        "still": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "moving": "query.modified_move_speed > 0.05"
            }
          ],
          "blend_transition": 0.3
        },
        "moving": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "still": "!(query.modified_move_speed > 0.05)"
            }
          ],
          "blend_transition": 0.3
        }
      }
    },
    "controller.animation.hb.mimicer.flow": {
      "initial_state": "still",
      "states": {
        "still": {
          "animations": [
            "idle"
          ],
          "transitions": [
