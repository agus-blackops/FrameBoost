            }
          ],
          "blend_transition": 0.3
        },
        "moving": {
          "animations": [
            {
              "walk": "!(query.property('hb:mode') == 'chase')"
            },
            {
              "run": "query.property('hb:mode') == 'chase'"
            }
          ],
          "transitions": [
            {
              "still": "!(query.modified_move_speed > 0.05)"
            }
          ],
          "blend_transition": 0.3
        }
      }
    },
