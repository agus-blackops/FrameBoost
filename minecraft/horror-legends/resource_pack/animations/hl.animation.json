          ]
        },
        "backRightUpper": {
          "rotation": [
            0,
            "math.cos(query.modified_distance_moved * 45) * -22.0 * query.modified_move_speed",
            "math.max(0.0, -math.sin(query.modified_distance_moved * 45.0)) * 16.0 * query.modified_move_speed"
          ]
        },
        "body": {
          "position": [
            0,
            "math.abs(math.sin(query.modified_distance_moved * 45.0)) * 0.6 * query.modified_move_speed",
            0
          ],
          "rotation": [
            0,
            0,
            "math.sin(query.modified_distance_moved * 45.0) * 3.0 * query.modified_move_speed"
          ]
        }
      }
    },
