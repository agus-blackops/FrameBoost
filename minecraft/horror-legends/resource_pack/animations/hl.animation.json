{
  "format_version": "1.8.0",
  "animations": {
    "animation.hl.humanoid.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.hl.herobrine.stand": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            0,
            0,
            1.5
          ]
        },
        "leftArm": {
          "rotation": [
            0,
            0,
            -1.5
          ]
        }
      }
    },
    "animation.hl.null.glitch": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            "math.random(0.0, 1.0) > 0.93 ? math.random(-1.5, 1.5) : 0.0",
            0,
            "math.random(0.0, 1.0) > 0.93 ? math.random(-1.5, 1.5) : 0.0"
          ]
        },
        "head": {
          "rotation": [
            0,
            "math.random(0.0, 1.0) > 0.97 ? math.random(-40.0, 40.0) : 0.0",
            0
          ]
        },
        "glitch": {
          "position": [
            "math.random(-0.8, 0.8)",
            "math.random(-0.8, 0.8)",
            "math.random(-0.8, 0.8)"
          ],
          "rotation": [
            0,
            "query.life_time * 90.0",
            0
          ]
        }
      }
    },
    "animation.hl.fog_man.walk": {
      "loop": true,
      "bones": {
        "rightLeg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30) * 32.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leftLeg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30) * -32.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "rightShin": {
          "rotation": [
            "math.max(0.0, math.sin(query.modified_distance_moved * 30.0)) * 40.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leftShin": {
          "rotation": [
            "math.max(0.0, -math.sin(query.modified_distance_moved * 30.0)) * 40.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "rightArm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30) * -22.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leftArm": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30) * 22.0 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.hl.fog_man.watch": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "4.0 + math.sin(query.life_time * 30.0) * 1.5",
