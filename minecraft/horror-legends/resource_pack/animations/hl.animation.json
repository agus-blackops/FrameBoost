      "loop": true,
      "bones": {
        "jaw": {
          "rotation": [
            "22.0 + math.sin(query.life_time * 900.0) * 16.0",
            0,
            0
          ]
        },
        "neck": {
          "rotation": [
            -10.0,
            0,
            0
          ]
        }
      }
