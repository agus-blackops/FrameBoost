            0
          ]
        },
        "head": {
          "rotation": [
            0,
            0,
            "18.0 + math.sin(query.life_time * 40.0) * 4.0"
          ]
        },
        "jaw": {
          "rotation": [
            "4.0 + math.sin(query.life_time * 60.0) * 3.0",
