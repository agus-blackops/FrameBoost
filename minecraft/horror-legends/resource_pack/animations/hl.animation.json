        "chest": {
          "rotation": [
            8.0,
            0,
            0
          ]
        },
        "neck": {
          "rotation": [
            -18.0,
            0,
            0
          ]
        },
        "head": {
          "rotation": [
            -22.0,
            0,
            0
          ]
        },
        "jaw": {
          "rotation": [
            "26.0 + math.sin(query.life_time * 1100.0) * 6.0",
