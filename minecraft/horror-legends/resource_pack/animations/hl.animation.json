        "leftForearm": {
          "rotation": [
            -25.0,
            0,
            0
          ]
        }
      }
    },
    "animation.hl.fog_man.attack": {
      "loop": true,
      "bones": {
        "rightArm": {
          "rotation": [
            "-math.sin(variable.attack_time * 180.0) * 120.0",
            0,
            0
          ]
        },
        "leftArm": {
          "rotation": [
            "-math.sin(variable.attack_time * 180.0) * 100.0",
            0,
            0
          ]
        }
      }
    },
    "animation.hl.crawler.walk": {
      "loop": true,
      "bones": {
        "frontRightUpper": {
          "rotation": [
            0,
            "math.cos(query.modified_distance_moved * 45) * 22.0 * query.modified_move_speed",
