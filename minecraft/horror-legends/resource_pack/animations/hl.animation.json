          ]
        },
        "backLeftUpper": {
          "rotation": [
            0,
            "math.cos(query.modified_distance_moved * 45) * 22.0 * query.modified_move_speed",
            "-math.max(0.0, math.sin(query.modified_distance_moved * 45.0)) * 16.0 * query.modified_move_speed"
          ]
        },
        "frontLeftUpper": {
          "rotation": [
            0,
            "math.cos(query.modified_distance_moved * 45) * -22.0 * query.modified_move_speed",
