{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.hl.default": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.hl.null": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": "math.random(0.0, 1.0) > 0.04"
        },
        {
          "halo": "math.mod(math.floor(query.life_time * 7.0), 3) != 0"
        }
      ]
    },
    "controller.render.hl.fake_player": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.property('hl:eyes') ? Texture.eyes : Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "tool": "query.property('hl:state') == 'swing'"
        }
      ]
    }
  }
}
