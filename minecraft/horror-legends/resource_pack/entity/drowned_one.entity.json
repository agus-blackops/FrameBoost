{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "hl:drowned_one",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/hl/drowned_one"
      },
      "geometry": {
        "default": "geometry.hl.drowned_one"
      },
      "animations": {
        "idle": "animation.hl.drowned.idle",
        "walk": "animation.hl.drowned.walk",
        "swim": "animation.hl.drowned.swim",
        "attack": "animation.hl.drowned.attack"
      },
      "scripts": {
        "animate": [
          "idle",
          {
            "walk": "query.modified_move_speed > 0.05 && !query.is_in_water"
          },
          {
            "swim": "query.is_in_water"
          },
          {
            "attack": "variable.attack_time > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.hl.default"
      ],
      "spawn_egg": {
        "base_color": "#5e7278",
        "overlay_color": "#0b0e12"
      }
    }
  }
}
