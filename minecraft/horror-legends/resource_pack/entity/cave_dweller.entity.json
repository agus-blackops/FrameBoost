{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "hl:cave_dweller",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/hl/cave_dweller"
      },
      "geometry": {
        "default": "geometry.hl.cave_dweller"
      },
      "animations": {
        "walk": "animation.hl.crawler.walk",
        "breathe": "animation.hl.crawler.breathe",
        "look": "animation.hl.crawler.look",
        "twitch": "animation.hl.crawler.twitch",
        "jaw_idle": "animation.hl.crawler.jaw_idle",
        "jaw_snap": "animation.hl.crawler.jaw_snap"
      },
      "scripts": {
        "animate": [
          "walk",
          "breathe",
          "look",
          "twitch",
          {
            "jaw_idle": "query.mark_variant != 1"
          },
          {
            "jaw_snap": "query.mark_variant == 1"
          }
        ]
      },
      "render_controllers": [
        "controller.render.hl.default"
      ],
      "spawn_egg": {
        "base_color": "#c6c2b8",
        "overlay_color": "#06060a"
      }
    }
  }
}
