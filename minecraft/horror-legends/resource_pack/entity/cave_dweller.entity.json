{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "hl:cave_dweller",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/hl/cave_dweller"
      },
      "geometry": {
        "default": "geometry.hl.cave_dweller"
      },
      "animations": {
        "walk": "animation.hl.dweller.walk",
        "idle": "animation.hl.dweller.idle",
        "look": "animation.hl.dweller.look",
        "twitch": "animation.hl.dweller.twitch",
        "lips_idle": "animation.hl.dweller.lips_idle",
        "lips_open": "animation.hl.dweller.lips_open",
        "attack": "animation.hl.dweller.attack",
        "hurt": "animation.hl.dweller.hurt",
        "emerge": "animation.hl.dweller.emerge",
        "walk_extra": "animation.hl.dweller.walk_extra"
      },
      "scripts": {
        "animate": [
          "walk",
          "idle",
          "look",
          "twitch",
          {
            "lips_idle": "!(query.property('hl:mode') == 'chase')"
          },
          {
            "lips_open": "query.property('hl:mode') == 'chase'"
          },
          {
            "attack": "variable.attack_time > 0.0"
          },
          {
            "hurt": "query.hurt_time > 0"
          },
          "emerge",
          {
            "walk_extra": "query.modified_move_speed > 0.05"
          }
        ]
      },
      "render_controllers": [
        "controller.render.hl.default"
      ],
      "spawn_egg": {
        "base_color": "#d6d6ce",
        "overlay_color": "#48121c"
      }
    }
  }
}
