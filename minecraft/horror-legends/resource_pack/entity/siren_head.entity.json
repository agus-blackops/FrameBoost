{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "hl:siren_head",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/hl/siren_head"
      },
      "geometry": {
        "default": "geometry.hl.siren_head"
      },
      "animations": {
        "look": "animation.hl.siren.look",
        "idle": "animation.hl.siren.idle",
        "walk": "animation.hl.siren.walk",
        "hunt": "animation.hl.siren.hunt",
        "attack": "animation.hl.siren.attack"
      },
      "scripts": {
        "animate": [
          "look",
          "idle",
          {
            "walk": "query.modified_move_speed > 0.05"
          },
          {
            "hunt": "query.property('hl:mode') == 'hunt'"
          },
          {
            "attack": "variable.attack_time > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.hl.default"
      ],
      "spawn_egg": {
        "base_color": "#54402e",
        "overlay_color": "#a05c28"
      }
    }
  }
}
