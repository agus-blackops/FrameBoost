{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "hl:herobrine",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/hl/herobrine"
      },
      "geometry": {
        "default": "geometry.hl.herobrine"
      },
      "animations": {
        "look": "animation.hl.herobrine.look",
        "idle": "animation.hl.herobrine.idle",
        "tail": "animation.hl.herobrine.tail",
        "twitch": "animation.hl.herobrine.twitch",
        "walk": "animation.hl.herobrine.walk",
        "strike": "animation.hl.herobrine.strike",
        "walk_extra": "animation.hl.herobrine.walk_extra"
      },
      "scripts": {
        "animate": [
          "look",
          "idle",
          "tail",
          "twitch",
          {
            "walk": "query.modified_move_speed > 0.05"
          },
          {
            "strike": "query.property('hl:strike')"
          },
          {
            "walk_extra": "query.modified_move_speed > 0.05"
          }
        ]
      },
      "render_controllers": [
        "controller.render.hl.default"
      ],
      "spawn_egg": {
        "base_color": "#1e8486",
        "overlay_color": "#a62a22"
      }
    }
  }
}
