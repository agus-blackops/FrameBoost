{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "tam:imposter",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "tam:variant_0": { "minecraft:variant": { "value": 0 } },
      "tam:variant_1": { "minecraft:variant": { "value": 1 } },
      "tam:variant_2": { "minecraft:variant": { "value": 2 } },

      "tam:disguised": {
        "minecraft:mark_variant": { "value": 0 },
        "minecraft:type_family": { "family": ["tam_imposter", "tam_disguised", "mob"] },
        "minecraft:movement": { "value": 0.23 },
        "minecraft:behavior.look_at_player": {
          "priority": 5,
          "look_distance": 20,
          "probability": 0.9,
          "angle_of_view_horizontal": 360
        },
        "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.8 },
        "minecraft:behavior.random_look_around": { "priority": 7 },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": { "test": "distance_to_nearest_player", "operator": "<", "value": 2.5 },
              "event": "tam:reveal"
            }
          ]
        },
        "minecraft:damage_sensor": {
          "triggers": [{ "on_damage": { "event": "tam:reveal" } }]
        },
        "minecraft:timer": {
          "looping": true,
          "time": [30, 90],
          "randomInterval": true,
          "time_down_event": { "event": "tam:maybe_reveal" }
        }
      },

      "tam:revealed": {
        "minecraft:mark_variant": { "value": 1 },
        "minecraft:type_family": { "family": ["tam_imposter", "tam_revealed", "monster", "mob"] },
        "minecraft:movement": { "value": 0.33 },
        "minecraft:attack": { "damage": 5 },
        "minecraft:behavior.hurt_by_target": { "priority": 1 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": true,
          "must_see_forget_duration": 6.0,
          "reselect_targets": true,
          "within_radius": 32.0,
          "entity_types": [
            {
              "filters": {
                "any_of": [
                  { "test": "is_family", "subject": "other", "value": "player" },
                  { "test": "is_family", "subject": "other", "value": "villager" },
                  { "test": "is_family", "subject": "other", "value": "wandering_trader" }
                ]
              },
              "max_dist": 32
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "speed_multiplier": 1.25,
          "track_target": true
        },
        "minecraft:behavior.random_stroll": { "priority": 7, "speed_multiplier": 1.0 },
        "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 12 },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "all_of": [
                  { "test": "is_daytime", "value": true },
                  { "test": "distance_to_nearest_player", "operator": ">", "value": 24 }
                ]
              },
              "event": "tam:redisguise"
            }
          ]
        }
      }
    },

    "components": {
      "minecraft:type_family": { "family": ["tam_imposter", "mob"] },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:collision_box": { "width": 0.6, "height": 1.9 },
      "minecraft:health": { "value": 30, "max": 30 },
      "minecraft:follow_range": { "value": 40, "max": 40 },
      "minecraft:nameable": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0 },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:loot": { "table": "loot_tables/entities/tam_imposter.json" },
      "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? 10 : 0" },
      "minecraft:despawn": { "despawn_from_distance": {} },
      "minecraft:ambient_sound_interval": { "value": 8.0, "range": 16.0, "event_name": "ambient" },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_open_doors": true,
        "can_pass_doors": true
      },
      "minecraft:annotation.open_door": {},
      "minecraft:behavior.open_door": { "priority": 6, "close_door_after": true },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:conditional_bandwidth_optimization": {}
    },

    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "randomize": [
              { "weight": 1, "add": { "component_groups": ["tam:variant_0"] } },
              { "weight": 1, "add": { "component_groups": ["tam:variant_1"] } },
              { "weight": 1, "add": { "component_groups": ["tam:variant_2"] } }
            ]
          },
          { "add": { "component_groups": ["tam:disguised"] } }
        ]
      },
      "tam:reveal": {
        "remove": { "component_groups": ["tam:disguised"] },
        "add": { "component_groups": ["tam:revealed"] }
      },
      "tam:redisguise": {
        "remove": { "component_groups": ["tam:revealed"] },
        "add": { "component_groups": ["tam:disguised"] }
      },
      "tam:maybe_reveal": {
        "sequence": [
          {
            "filters": { "test": "is_daytime", "value": false },
            "randomize": [
              {
                "weight": 35,
                "remove": { "component_groups": ["tam:disguised"] },
                "add": { "component_groups": ["tam:revealed"] }
              },
              { "weight": 65, "add": { "component_groups": ["tam:disguised"] } }
            ]
          }
        ]
      }
    }
  }
}
