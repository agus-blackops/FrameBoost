{
  "format_version": "1.8.0",
  "animations": {
    "animation.tam.humanoid.walk": {
      "loop": true,
      "bones": {
        "rightLeg": { "rotation": ["math.cos(query.modified_distance_moved * 38.17) * 70.0 * query.modified_move_speed", 0, 0] },
        "leftLeg": { "rotation": ["-math.cos(query.modified_distance_moved * 38.17) * 70.0 * query.modified_move_speed", 0, 0] },
        "rightArm": { "rotation": ["-math.cos(query.modified_distance_moved * 38.17) * 50.0 * query.modified_move_speed", 0, 0] },
        "leftArm": { "rotation": ["math.cos(query.modified_distance_moved * 38.17) * 50.0 * query.modified_move_speed", 0, 0] }
      }
    },
    "animation.tam.humanoid.look_at_target": {
      "loop": true,
      "bones": {
        "head": { "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0] }
      }
    },
    "animation.tam.humanoid.attack": {
      "loop": true,
      "bones": {
        "rightArm": { "rotation": ["-math.sin(variable.attack_time * 180.0) * 110.0", 0, 0] },
        "leftArm": { "rotation": ["-math.sin(variable.attack_time * 180.0) * 90.0", 0, 0] }
      }
    },
    "animation.tam.face.twitch": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "math.random(-9.0, 9.0)",
            "math.sin(query.life_time * 1100.0) * 12.0",
            "math.random(-16.0, 16.0)"
          ]
        }
      }
    },
    "animation.tam.face.stretch": {
      "loop": true,
      "bones": {
        "head": { "scale": [0.92, "1.45 + math.sin(query.life_time * 420.0) * 0.08", 0.92] }
      }
    },
    "animation.tam.body.spasm": {
      "loop": true,
      "bones": {
        "body": { "rotation": [8.0, 0, "math.random(-2.5, 2.5)"] },
        "rightArm": { "rotation": ["-12.0 + math.random(-8.0, 8.0)", 0, "math.random(0.0, 10.0)"] },
        "leftArm": { "rotation": ["-12.0 + math.random(-8.0, 8.0)", 0, "math.random(-10.0, 0.0)"] }
      }
    },
    "animation.tam.body.stare": {
      "loop": true,
      "bones": {
        "rightArm": { "rotation": [0, 0, 4.0] },
        "leftArm": { "rotation": [0, 0, -4.0] },
        "head": { "rotation": [0, 0, "math.sin(query.life_time * 30.0) * 6.0 + 14.0"] }
      }
    }
  }
}
