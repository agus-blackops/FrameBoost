; Engine configuration file.
; It's best edited using the editor UI and not directly, since
; the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Trastazo Playground"
config/description="Laboratorio de muñecos, trampas y caos (Godot)"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "C#", "Mobile")
run/max_fps=60
boot_splash/bg_color=Color(0.043, 0.055, 0.078, 1)
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="disabled"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true

[dotnet]

project/assembly_name="Trastazo"

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/vram_compression/import_etc2_astc=true
